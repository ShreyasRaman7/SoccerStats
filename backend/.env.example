# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Your Telegram user ID (the bot will send clip files to this chat)
TELEGRAM_OWNER_ID=123456789

# ── AI (optional — uses keyword scoring if not set) ───────────────────────────
OPENAI_API_KEY=

# ── TikTok ────────────────────────────────────────────────────────────────────
TIKTOK_ACCESS_TOKEN=

# ── Instagram (Meta Graph API) ────────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ── YouTube (OAuth2 — run python platforms.py --auth to generate) ─────────────
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json

# ── Server ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Processing ────────────────────────────────────────────────────────────────
# Minimum viral score (0-100) for a clip to be kept
MIN_VIRAL_SCORE=70
# Max clips to extract per video
MAX_CLIPS_PER_VIDEO=8
# Whisper model size: tiny / base / small / medium
WHISPER_MODEL=base
